NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Complaint email delivery (Resend). Reports are still saved in Supabase if these are blank.
RESEND_API_KEY=
REPORT_TO_EMAIL=
# For production, use a sender on a domain verified in Resend.
REPORT_FROM_EMAIL=Marketplace Reports <onboarding@resend.dev>

# New-message email alerts (2026-10 update).
# Supabase → Project Settings → API → "service_role" key. SERVER ONLY — never share it or put it in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
# Sender for "you have a new message" emails. Must be on a domain verified in Resend.
NOTIFY_FROM_EMAIL=youqiu <notify@your-domain.com>
# Public HTTPS production URL, not a localhost or preview URL.
SITE_URL=
# Random server-only secret shared with the Supabase outbox webhook.
MESSAGE_WEBHOOK_SECRET=
# Optional authenticated retry endpoint; not a scheduler by itself.
CRON_SECRET=
